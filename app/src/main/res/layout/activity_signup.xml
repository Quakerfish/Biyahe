<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary" />

        <!-- Screen Title Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/signup_title"
            android:textColor="@color/brand_orange"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/signup_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Full name -->
        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="24dp"
            android:text="@string/label_full_name" />

        <LinearLayout style="@style/FieldWrap">
            <ImageView style="@style/FieldIcon" android:src="@drawable/ic_person" />
            <EditText
                android:id="@+id/etFullName"
                style="@style/FieldInput"
                android:autofillHints="name"
                android:hint="@string/hint_full_name"
                android:imeOptions="actionNext"
                android:inputType="textPersonName" />
        </LinearLayout>

        <!-- Email -->
        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="16dp"
            android:text="@string/label_email" />

        <LinearLayout style="@style/FieldWrap">
            <ImageView style="@style/FieldIcon" android:src="@drawable/ic_email" />
            <EditText
                android:id="@+id/etEmail"
                style="@style/FieldInput"
                android:autofillHints="emailAddress"
                android:hint="@string/hint_email"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <!-- Password -->
        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="16dp"
            android:text="@string/label_password" />

        <LinearLayout style="@style/FieldWrap">
            <ImageView style="@style/FieldIcon" android:src="@drawable/ic_lock" />
            <EditText
                android:id="@+id/etPassword"
                style="@style/FieldInput"
                android:autofillHints="newPassword"
                android:hint="@string/hint_password"
                android:imeOptions="actionNext"
                android:inputType="textPassword" />
            <ImageButton
                android:id="@+id/btnTogglePassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/label_password"
                android:src="@drawable/ic_eye"
                android:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Confirm password -->
        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="16dp"
            android:text="@string/label_confirm_password" />

        <LinearLayout style="@style/FieldWrap">
            <ImageView style="@style/FieldIcon" android:src="@drawable/ic_lock" />
            <EditText
                android:id="@+id/etConfirmPassword"
                style="@style/FieldInput"
                android:autofillHints="newPassword"
                android:hint="@string/hint_confirm_password"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />
            <ImageButton
                android:id="@+id/btnToggleConfirmPassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/label_confirm_password"
                android:src="@drawable/ic_eye"
                android:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Terms checkbox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbAgreeTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/brand_orange" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agree_terms_prefix"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/terms_of_service"
                    android:textColor="@color/brand_orange"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Create account button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCreateAccount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/btn_create_account"
            android:textAllCaps="false"
            android:textColor="@color/text_on_brand"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Login link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/already_have_account"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="2dp"
                android:text="@string/log_in"
                android:textColor="@color/brand_orange"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
