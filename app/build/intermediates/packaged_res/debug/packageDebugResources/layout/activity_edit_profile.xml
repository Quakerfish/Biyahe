<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- Scrollable Form Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Toolbar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_back"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Edit Profile"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Profile Picture Header Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <FrameLayout
                    android:id="@+id/btnChangeAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivEditAvatar"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:contentDescription="@null"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_avatar_circle"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/brand_orange" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Tap to change profile picture"
                    android:textColor="@color/text_muted"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- Personal Information Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="Personal Information"
                    android:textAllCaps="true"
                    android:textColor="@color/brand_orange"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Username -->
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="Username" />

                <LinearLayout style="@style/FieldWrap">
                    <EditText
                        android:id="@+id/etUsername"
                        style="@style/FieldInput"
                        android:autofillHints="username"
                        android:hint="Enter your username"
                        android:inputType="textPersonName" />
                </LinearLayout>

                <!-- Email Address -->
                <TextView
                    style="@style/FieldLabel"
                    android:text="Email Address" />

                <LinearLayout style="@style/FieldWrap">
                    <EditText
                        android:id="@+id/etEmail"
                        style="@style/FieldInput"
                        android:autofillHints="emailAddress"
                        android:hint="Enter your email"
                        android:inputType="textEmailAddress" />
                </LinearLayout>
            </LinearLayout>

            <!-- Password Security Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="Change Password (Optional)"
                    android:textAllCaps="true"
                    android:textColor="@color/brand_orange"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Current Password -->
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="Current Password" />

                <LinearLayout style="@style/FieldWrap">
                    <EditText
                        android:id="@+id/etCurrentPassword"
                        style="@style/FieldInput"
                        android:autofillHints="password"
                        android:hint="Required only if changing password"
                        android:inputType="textPassword" />
                </LinearLayout>

                <!-- New Password -->
                <TextView
                    style="@style/FieldLabel"
                    android:text="New Password" />

                <LinearLayout style="@style/FieldWrap">
                    <EditText
                        android:id="@+id/etNewPassword"
                        style="@style/FieldInput"
                        android:autofillHints="password"
                        android:hint="Leave blank to keep current"
                        android:inputType="textPassword" />
                </LinearLayout>
            </LinearLayout>

            <!-- Save Changes Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_primary"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textColor="@color/text_on_brand"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
