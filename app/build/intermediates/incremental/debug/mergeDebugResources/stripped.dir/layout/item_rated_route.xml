<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Route Code & Date Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRatedRouteCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_soft"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/ph_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="01K" />

            <TextView
                android:id="@+id/tvRatedRouteName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Carbon Market – Lahug" />

            <TextView
                android:id="@+id/tvRatedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp"
                tools:text="2 days ago" />
        </LinearLayout>

        <!-- Ratings Ratings Bar Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Route Accuracy Rating -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_fare_tile_regular"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Route Path"
                    android:textColor="@color/ph_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <RatingBar
                    android:id="@+id/rbRouteAccuracy"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressTint="@color/ph_yellow"
                    android:secondaryProgressTint="@color/ph_yellow"
                    android:stepSize="1" />
            </LinearLayout>

            <!-- Fare Accuracy Rating -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_fare_tile_regular"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fare Accuracy"
                    android:textColor="@color/ph_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <RatingBar
                    android:id="@+id/rbFareAccuracy"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressTint="@color/ph_yellow"
                    android:secondaryProgressTint="@color/ph_yellow"
                    android:stepSize="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- User Comment Text -->
        <TextView
            android:id="@+id/tvRatedComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="&quot;Route was exact and driver charged standard fare.&quot;" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
