<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Left Colored Indicator Bar -->
        <View
            android:id="@+id/vRouteColorIndicator"
            android:layout_width="5dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="#0038A8" />

        <!-- Route / Terminal Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Jeepney Code or Terminal Badge -->
            <TextView
                android:id="@+id/tvSheetItemRouteCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_soft"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="01K"
                android:textColor="@color/ph_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Origin - Destination or Terminal Name -->
            <TextView
                android:id="@+id/tvSheetItemRouteName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Urqello – Parkmall"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvSheetItemRouteSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="via Sanciangko, Mandaue · 12 jeeps on route"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Right Save Button & Chevron -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnSheetSaveRoute"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Save route"
                android:padding="6dp"
                android:src="@drawable/ic_bookmark"
                app:tint="@color/text_muted" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_muted" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
